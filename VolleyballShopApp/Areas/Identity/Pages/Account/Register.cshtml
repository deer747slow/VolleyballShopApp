@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<style>
    .register-wrapper {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 30px 15px;
    }

    .register-card {
        width: 100%;
        max-width: 650px;
        background: #ffffff;
        border-radius: 24px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.10);
        overflow: hidden;
    }

    .register-top {
        background: linear-gradient(135deg, #0a1f44, #123a7a);
        padding: 35px 25px;
        text-align: center;
        color: white;
    }

        .register-top h1 {
            margin: 0;
            font-weight: 800;
            font-size: 2.2rem;
        }

        .register-top p {
            margin-top: 10px;
            color: #dce6f7;
        }

    .register-body {
        padding: 30px;
    }

    .register-subtitle {
        text-align: center;
        font-weight: 700;
        color: #0a1f44;
        margin-bottom: 20px;
    }

    .form-control {
        border-radius: 14px;
        min-height: 56px;
        border: 1px solid #d7dee8;
    }

        .form-control:focus {
            border-color: #123a7a;
            box-shadow: 0 0 0 0.2rem rgba(18,58,122,0.12);
        }

    .register-btn {
        background: linear-gradient(135deg, #ffd60a, #f4b400);
        color: #111;
        border: none;
        border-radius: 35px;
        font-weight: 800;
        padding: 14px;
        box-shadow: 0 8px 18px rgba(255,214,10,0.30);
        transition: 0.2s ease;
    }

        .register-btn:hover {
            transform: translateY(-2px);
            color: #111;
            background: linear-gradient(135deg, #ffe14a, #f4be00);
        }

    .divider {
        height: 1px;
        background: linear-gradient(to right, transparent, #d7dee8, transparent);
        margin: 20px 0;
        border: none;
    }

    .icon {
        font-size: 45px;
        margin-bottom: 10px;
    }
</style>

<div class="register-wrapper">
    <div class="register-card">

        <!-- HEADER -->
        <div class="register-top">
            <div class="icon">🏐</div>
            <h1>Регистрация</h1>
            <p>Създай нов акаунт във VolleyballShop</p>
        </div>

        <!-- BODY -->
        <div class="register-body">
            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">

                <h2 class="register-subtitle">Създай акаунт</h2>

                <hr class="divider" />

                <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-3"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.FirstName" class="form-control" />
                    <label asp-for="Input.FirstName"></label>
                    <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.LastName" class="form-control" />
                    <label asp-for="Input.LastName"></label>
                    <span asp-validation-for="Input.LastName" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Address" class="form-control" />
                    <label asp-for="Input.Address"></label>
                    <span asp-validation-for="Input.Address" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.UserName" class="form-control" />
                    <label asp-for="Input.UserName"></label>
                    <span asp-validation-for="Input.UserName" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" />
                    <label asp-for="Input.Email"></label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" />
                    <label asp-for="Input.Password"></label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form-floating mb-4">
                    <input asp-for="Input.ConfirmPassword" class="form-control" />
                    <label asp-for="Input.ConfirmPassword"></label>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <button id="registerSubmit" type="submit" class="w-100 btn register-btn">
                    Създай акаунт
                </button>
            </form>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}