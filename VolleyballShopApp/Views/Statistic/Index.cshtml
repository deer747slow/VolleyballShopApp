@using Microsoft.AspNetCore.Identity
@using VolleyballShopApp.Infrastructure.Data.Entities
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<style>
    .login-partial-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .login-partial-user {
        color: white !important;
        font-weight: 500;
        text-decoration: none;
        white-space: nowrap;
        font-size: 15px;
    }

        .login-partial-user:hover {
            color: #ffd60a !important;
        }

    .logout-small-btn {
        background: transparent;
        border: 1px solid #ffd60a;
        color: #ffd60a;
        border-radius: 20px;
        padding: 5px 12px;
        font-size: 14px;
        font-weight: 600;
    }

        .logout-small-btn:hover {
            background: #ffd60a;
            color: black;
        }

    .auth-link {
        color: white !important;
        font-weight: 500;
        text-decoration: none;
        margin-left: 10px;
    }

        .auth-link:hover {
            color: #ffd60a !important;
        }

    .logout-form-inline {
        margin: 0;
    }
</style>

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <div class="login-partial-wrap">
                <a class="login-partial-user"
                   asp-area="Identity"
                   asp-page="/Account/Manage/Index"
                   title="Manage">
                    @User.Identity?.Name
                </a>

                <form class="logout-form-inline"
                      asp-area="Identity"
                      asp-page="/Account/Logout"
                      asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                      method="post">
                    <button type="submit" class="logout-small-btn">Изход</button>
                </form>
            </div>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="auth-link" asp-area="Identity" asp-page="/Account/Register">Регистрация</a>
        </li>
        <li class="nav-item">
            <a class="auth-link" asp-area="Identity" asp-page="/Account/Login">Вход</a>
        </li>
    }
</ul>