@using VolleyballShopApp.Models.Statistic
@model StatisticVM
@{
    ViewData["Title"] = "Statistics";
}

<style>
    .statistics-title {
        color: #0a1f44;
        font-weight: 800;
        margin-bottom: 25px;
        font-size: 2rem;
    }

    .statistics-box {
        background: #ffffff;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 8px 22px rgba(0,0,0,0.08);
        margin-top: 20px;
    }

    .statistics-summary {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
        margin-bottom: 10px;
    }

    .statistics-card {
        background: linear-gradient(135deg, #0a1f44, #123a7a);
        color: white;
        border-radius: 18px;
        padding: 20px;
        text-align: center;
        box-shadow: 0 6px 16px rgba(10,31,68,0.18);
        transition: 0.2s ease;
    }

        .statistics-card:hover {
            transform: translateY(-4px);
        }

    .statistics-card-title {
        font-size: 14px;
        font-weight: 600;
        margin-bottom: 10px;
        opacity: 0.95;
    }

    .statistics-card-value {
        font-size: 28px;
        font-weight: 800;
        margin: 0;
    }

    .statistics-wrapper {
        display: flex;
        justify-content: center;
    }
</style>

<h4 class="text-center statistics-title">📊 Statistic</h4>

<div class="statistics-wrapper">
    <div class="col-xl-8">
        <div class="statistics-box">

            <div class="statistics-summary">
                <div class="statistics-card">
                    <div class="statistics-card-title">@Html.DisplayNameFor(model => model.CountClients)</div>
                    <p class="statistics-card-value">@Html.DisplayFor(model => model.CountClients)</p>
                </div>

                <div class="statistics-card">
                    <div class="statistics-card-title">@Html.DisplayNameFor(model => model.CountProducts)</div>
                    <p class="statistics-card-value">@Html.DisplayFor(model => model.CountProducts)</p>
                </div>

                <div class="statistics-card">
                    <div class="statistics-card-title">@Html.DisplayNameFor(model => model.CountOrders)</div>
                    <p class="statistics-card-value">@Html.DisplayFor(model => model.CountOrders)</p>
                </div>

                <div class="statistics-card">
                    <div class="statistics-card-title">@Html.DisplayNameFor(model => model.SumOrders)</div>
                    <p class="statistics-card-value">@Html.DisplayFor(model => model.SumOrders)</p>
                </div>
            </div>

        </div>
    </div>
</div>