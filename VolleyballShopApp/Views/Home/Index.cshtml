@{
    ViewData["Title"] = "Начало";
}

<div class="container-fluid px-0">
    <!-- Тъмен фон за цялото съдържание под hero -->
    <div class="bg-dark py-5">
        <div class="container">

            <!-- Welcome секция -->
            <div class="text-center mb-5">
                <h1 class="display-4 fw-bold text-white mb-3">
                    Добре дошли във <span class="text-warning">VolleyballShop</span>
                </h1>
                <p class="lead text-light fs-3">
                    Професионално волейболно оборудване за всеки играч
                </p>
            </div>

            <!-- Три предимства -->
            <div class="row g-4 mb-5">
                <div class="col-md-4">
                    <div class="card bg-dark border border-secondary shadow h-100 text-center p-4">
                        <div class="mb-3 text-warning">
                            <i class="fas fa-volleyball-ball fa-3x"></i>
                        </div>
                        <h4 class="text-white">Високо качество</h4>
                        <p class="text-light-emphasis">Оригинални продукти от топ марки</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-dark border border-secondary shadow h-100 text-center p-4">
                        <div class="mb-3 text-warning">
                            <i class="fas fa-truck fa-3x"></i>
                        </div>
                        <h4 class="text-white">Бърза доставка</h4>
                        <p class="text-light-emphasis">До 2-3 работни дни в цялата страна</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card bg-dark border border-secondary shadow h-100 text-center p-4">
                        <div class="mb-3 text-warning">
                            <i class="fas fa-shield-alt fa-3x"></i>
                        </div>
                        <h4 class="text-white">Гаранция</h4>
                        <p class="text-light-emphasis">2 години гаранция на всички продукти</p>
                    </div>
                </div>
            </div>

            <!-- Призив за действие -->
            <div class="bg-gradient p-5 rounded-4 text-center border border-secondary">
                <h2 class="text-white mb-4">Готов ли си за следващия мач?</h2>
                <p class="lead text-light mb-4">
                    Разгледай нашата широка гама от волейболни топки, обувки, наколенки и екипировка.
                </p>
                <a asp-controller="Product" asp-action="Index" class="btn brand-btn btn-lg px-5 py-3 fs-5">
                    <i class="fas fa-shopping-bag"></i> Започни пазаруване сега
                </a>
            </div>

        </div>
    </div>
</div>