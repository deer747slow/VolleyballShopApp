@{
    ViewData["Title"] = "Контакти";
}

<style>
    .contact-page {
        padding: 20px 0 40px 0;
    }

    .contact-header {
        text-align: center;
        margin-bottom: 35px;
    }

        .contact-header h1 {
            color: #0a1f44;
            font-weight: 800;
            margin-bottom: 12px;
        }

        .contact-header p {
            color: #6c757d;
            font-size: 18px;
        }

    .contact-card {
        background: #ffffff;
        border-radius: 18px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.08);
        height: 100%;
        padding: 30px;
    }

        .contact-card h4 {
            color: #0a1f44;
            font-weight: 700;
            margin-bottom: 25px;
        }

    .contact-item {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        margin-bottom: 22px;
    }

    .contact-icon {
        font-size: 28px;
        width: 40px;
        text-align: center;
    }

    .contact-item strong {
        color: #0a1f44;
    }

    .contact-item span,
    .contact-item a {
        color: #6c757d;
        text-decoration: none;
    }

    .map-frame {
        border-radius: 14px;
        overflow: hidden;
    }
</style>

<div class="contact-page">

    <div class="contact-header">
        <h1>📩 Свържете се с нас</h1>
        <p>Имаш въпроси? Готови сме да ти помогнем.</p>
    </div>

    <div class="row g-4">

        <!-- ЛЯВО: Информация -->
        <div class="col-lg-5">
            <div class="contact-card">

                <h4>Контактна информация</h4>

                <div class="contact-item">
                    <div class="contact-icon">📍</div>
                    <div>
                        <strong>Адрес:</strong><br />
                        <span>Монте Карло, ул. „8-ми март“ 232, Перник</span>
                    </div>
                </div>

                <div class="contact-item">
                    <div class="contact-icon">📞</div>
                    <div>
                        <strong>Телефон:</strong><br />
                        <a href="tel:0888123456">0888 123 456</a>
                    </div>
                </div>

                <div class="contact-item">
                    <div class="contact-icon">✉️</div>
                    <div>
                        <strong>Имейл:</strong><br />
                        <a href="mailto:info@volleyballshop.bg">info@volleyballshop.bg</a>
                    </div>
                </div>

                <div class="contact-item mb-0">
                    <div class="contact-icon">🕒</div>
                    <div>
                        <strong>Работно време:</strong><br />
                        <span>Пон - Пет: 9:00 - 18:00</span><br />
                        <span>Събота: 10:00 - 14:00</span>
                    </div>
                </div>

            </div>
        </div>

        <!-- ДЯСНО: КАРТА -->
        <div class="col-lg-7">
            <div class="contact-card">

                <h4>Как да ни намерите</h4>

                <div class="ratio ratio-16x9 map-frame">
                    <iframe src="https://www.google.com/maps?q=8-mi%20mart%20232%20Pernik&output=embed"
                            width="100%" height="450" style="border:0;"
                            allowfullscreen="" loading="lazy">
                    </iframe>
                </div>

            </div>
        </div>

    </div>

</div>