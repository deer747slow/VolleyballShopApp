<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VolleyballShop</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <style>
        body {
            background-color: #f4f6fb;
            font-family: 'Segoe UI', sans-serif;
        }

        /* NAVBAR */
        .navbar {
            background: #0a1f44;
        }

        .navbar-brand {
            color: #ffd60a !important;
            font-weight: bold;
            font-size: 22px;
        }

        .nav-link {
            color: white !important;
            font-weight: 500;
        }

            .nav-link:hover {
                color: #ffd60a !important;
            }

        /* HERO */
        .hero {
            background: linear-gradient(135deg, #0a1f44, #123a7a);
            color: white;
            padding: 60px 20px;
            border-radius: 12px;
            text-align: center;
            margin-bottom: 30px;
        }

            .hero h1 {
                font-size: 42px;
                font-weight: bold;
            }

            .hero p {
                color: #dcdcdc;
                font-size: 18px;
            }

        /* БУТОНИ */
        .btn-main {
            background-color: #ffd60a;
            color: black;
            border: none;
            font-weight: bold;
            padding: 10px 25px;
            border-radius: 25px;
        }

            .btn-main:hover {
                background-color: #e6c200;
            }

        /* DROPDOWN */
        .dropdown-menu {
            border-radius: 10px;
        }

        /* КОНТЕЙНЕР */
        .content-box {
            background: white;
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 5px 15px rgba(0,0,0,0.05);
        }

        /* FOOTER */
        footer {
            background: #0a1f44;
            color: white;
            padding: 15px;
            text-align: center;
            margin-top: 40px;
        }

            footer a {
                color: #ffd60a;
            }

    </style>
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg shadow">
            <div class="container">

                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    🏐 VolleyballShop
                </a>

                <button class="navbar-toggler bg-light" data-bs-toggle="collapse" data-bs-target="#nav">
                    ☰
                </button>

                <div class="collapse navbar-collapse" id="nav">

                    <ul class="navbar-nav me-auto">

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Начало</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Contacts">Контакти</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Product" asp-action="Index">Продукти</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Order" asp-action="MyOrders">Моите поръчки</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Cart" asp-action="Index">Количка</a>
                        </li>

                        <!-- БРАНДОВЕ -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Марки</a>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Product"
                                       asp-action="Index"
                                       asp-route-searchStringBrandName="Mikasa">
                                        MIKASA
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Product"
                                       asp-action="Index"
                                       asp-route-searchStringBrandName="Molten">
                                        MOLTEN
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Product"
                                       asp-action="Index"
                                       asp-route-searchStringBrandName="Asics">
                                        ASICS
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Product"
                                       asp-action="Index"
                                       asp-route-searchStringBrandName="Mizuno">
                                        MIZUNO
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Product"
                                       asp-action="Index"
                                       asp-route-searchStringBrandName="Nike">
                                        NIKE
                                    </a>
                                </li>
                            </ul>
                        </li>

                        @if ((this.User.Identity.IsAuthenticated) && (this.User.IsInRole("Administrator")))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Админ</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="/Client/Index">Клиенти</a></li>
                                    <li><a class="dropdown-item" href="/Order/Index">Поръчки</a></li>
                                    <li><a class="dropdown-item" href="/Statistic/Index">Статистика</a></li>
                                </ul>
                            </li>
                        }

                    </ul>

                    <partial name="_LoginPartial" />

                </div>
            </div>
        </nav>
    </header>

    <div class="container">

        <!-- HERO -->
        <div class="hero">
            <h1>Играй като професионалист 🏐</h1>
            <p>Най-добрата екипировка за волейбол на едно място</p>
            <a href="/Product" class="btn btn-main mt-3">Разгледай продуктите</a>
        </div>

        <!-- СЪДЪРЖАНИЕ -->
        <div class="content-box">
            <main>
                @RenderBody()
            </main>
        </div>

    </div>

    <footer>
        <div class="container">
            VolleyballShop 
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>