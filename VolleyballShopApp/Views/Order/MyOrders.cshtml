@model IEnumerable<VolleyballShopApp.Models.Order.OrderIndexVM>

@{
    ViewData["Title"] = "Index";
}

<style>
    .orders-box {
        background: #ffffff;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.08);
        margin-top: 20px;
    }

    .orders-title {
        color: #0a1f44;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .orders-subtitle {
        color: #6c757d;
        margin-bottom: 20px;
    }

    .table thead {
        background: linear-gradient(135deg, #0a1f44, #123a7a);
        color: white;
    }

    .table th {
        border: none;
        padding: 12px;
    }

    .table td {
        vertical-align: middle;
        padding: 12px;
    }

    .table tbody tr {
        transition: all 0.2s ease;
    }

        .table tbody tr:hover {
            background-color: #f4f6fb;
            transform: scale(1.01);
        }

    .order-img {
        border-radius: 10px;
        width: 80px;
        height: 80px;
        object-fit: cover;
    }

    .price {
        font-weight: 600;
        color: #0a1f44;
    }

    .total-price {
        font-weight: 700;
        color: #198754;
    }

    .discount-badge {
        background: #dc3545;
        color: white;
        padding: 4px 8px;
        border-radius: 8px;
        font-size: 12px;
    }

    .empty-box {
        text-align: center;
        padding: 40px;
        color: #777;
    }
</style>

<h1 class="orders-title">🧾 Моите поръчки</h1>
<p class="orders-subtitle">Всички твои поръчки на едно място</p>

<div class="orders-box">

    @if (!Model.Any())
    {
        <div class="empty-box">
            <h4>Нямаш направени поръчки</h4>
        </div>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.OrderDate)</th>
                    <th>@Html.DisplayNameFor(model => model.Product)</th>
                    <th>@Html.DisplayNameFor(model => model.Picture)</th>
                    <th>@Html.DisplayNameFor(model => model.Quantity)</th>
                    <th>@Html.DisplayNameFor(model => model.Price)</th>
                    <th>@Html.DisplayNameFor(model => model.Discount)</th>
                    <th>@Html.DisplayNameFor(model => model.TotalPrice)</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.OrderDate)</td>

                        <td>
                            <strong>@Html.DisplayFor(modelItem => item.Product)</strong>
                        </td>

                        <td>
                            <img src="@Html.DisplayFor(modelItem => item.Picture)"
                                 alt="Image"
                                 class="order-img" />
                        </td>

                        <td>@Html.DisplayFor(modelItem => item.Quantity)</td>

                        <td class="price">
                            @Html.DisplayFor(modelItem => item.Price) лв.
                        </td>

                        <td>
                            @if (item.Discount > 0)
                            {
                                <span class="discount-badge">
                                    -@Html.DisplayFor(modelItem => item.Discount)%
                                </span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>

                        <td class="total-price">
                            @Html.DisplayFor(modelItem => item.TotalPrice) лв.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

</div>