@model VolleyballShopApp.Models.Client.ClientDeleteVM
@{
    ViewData["Title"] = "Delete";
}

<style>
    .delete-client-box {
        background: #ffffff;
        border-radius: 22px;
        padding: 30px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
        margin-top: 20px;
    }

    .delete-client-title {
        color: #0a1f44;
        font-weight: 800;
        margin-bottom: 10px;
    }

    .delete-client-warning {
        color: #dc3545;
        font-weight: 700;
        margin-bottom: 25px;
    }

    .delete-client-subtitle {
        color: #0a1f44;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .client-details-box {
        background: #f8f9fc;
        border-radius: 18px;
        padding: 20px 25px;
        border: 1px solid #e5eaf1;
    }

        .client-details-box dt {
            color: #0a1f44;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .client-details-box dd {
            color: #555;
            margin-bottom: 16px;
        }

    .delete-actions {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 25px;
    }

    .btn-delete-client {
        background: linear-gradient(135deg, #ff4d4f, #c82333);
        color: white;
        border: none;
        border-radius: 30px;
        padding: 10px 22px;
        font-weight: 700;
        transition: 0.2s ease;
    }

        .btn-delete-client:hover {
            background: linear-gradient(135deg, #ff6b6b, #a71d2a);
            color: white;
            transform: translateY(-2px);
        }

    .btn-back-client {
        background: linear-gradient(135deg, #ffd60a, #f4b400);
        color: #111;
        border: none;
        border-radius: 30px;
        padding: 10px 22px;
        font-weight: 700;
        text-decoration: none;
        transition: 0.2s ease;
        display: inline-block;
    }

        .btn-back-client:hover {
            color: #111;
            transform: translateY(-2px);
        }
</style>

<h1 class="delete-client-title">Delete</h1>
<h3 class="delete-client-warning">Are you sure you want to delete this?</h3>

<div class="delete-client-box">
    <h4 class="delete-client-subtitle">ClientDeleteVM</h4>
    <hr />

    <div class="client-details-box">
        <dl class="row">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.UserName)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.UserName)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.FirstName)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.FirstName)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.LastName)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.LastName)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Address)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Address)
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(model => model.Email)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(model => model.Email)
            </dd>
        </dl>
    </div>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />

        <div class="delete-actions">
            <input type="submit" value="Delete" class="btn btn-delete-client" />
            <a asp-action="Index" class="btn-back-client">Back to List</a>
        </div>
    </form>
</div>