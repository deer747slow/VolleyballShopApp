@model List<VolleyballShopApp.Models.Cart.CartItemVM>

@{
    ViewData["Title"] = "Количка";
    decimal grandTotal = Model.Sum(x => x.TotalPrice);
}

<h1 class="mb-4">🛒 Моята количка</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Количката е празна.
    </div>

    <a asp-controller="Product" asp-action="Index" class="btn btn-main">Към продуктите</a>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Снимка</th>
                <th>Продукт</th>
                <th>Цена</th>
                <th>Отстъпка</th>
                <th>Количество</th>
                <th>Общо</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <img src="@item.Picture" width="80" />
                    </td>
                    <td>@item.ProductName</td>
                    <td>@item.Price лв.</td>
                    <td>@item.Discount %</td>
                    <td>@item.Quantity</td>
                    <td>@item.TotalPrice.ToString("F2") лв.</td>
                    <td>
                        <a asp-controller="Cart" asp-action="Increase" asp-route-productId="@item.ProductId" class="btn btn-sm btn-success">+</a>
                        <a asp-controller="Cart" asp-action="Decrease" asp-route-productId="@item.ProductId" class="btn btn-sm btn-warning">-</a>
                        <a asp-controller="Cart" asp-action="Remove" asp-route-productId="@item.ProductId" class="btn btn-sm btn-danger">Премахни</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h4 class="mt-3">Крайна сума: <strong>@grandTotal.ToString("F2") лв.</strong></h4>

    <div class="mt-3">
        <a asp-controller="Cart" asp-action="Clear" class="btn btn-outline-danger">Изчисти количката</a>
        <a asp-controller="Product" asp-action="Index" class="btn btn-main">Продължи пазаруването</a>
    </div>
}