@{
    ViewData["Title"] = "Success";
}

<style>
    .success-box {
        background: #ffffff;
        border-radius: 16px;
        padding: 40px;
        text-align: center;
        box-shadow: 0 6px 18px rgba(0,0,0,0.08);
        margin-top: 30px;
    }

    .success-title {
        color: #0a1f44;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .success-icon {
        font-size: 50px;
        margin-bottom: 15px;
    }
</style>

<div class="success-box">
    <div class="success-icon">✅</div>

    <h1 class="success-title">You successfully removed a product!</h1>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-main">Back to List</a>
    </div>
</div>