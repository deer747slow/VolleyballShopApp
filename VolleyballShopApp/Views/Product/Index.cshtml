@model IEnumerable<VolleyballShopApp.Models.Product.ProductIndexVM>

@{
    ViewData["Title"] = "Продукти";
}

<h2 class="mb-4">🏐 Всички продукти</h2>

@if ((this.User.Identity.IsAuthenticated) && (this.User.IsInRole("Administrator")))
{
    <a asp-action="Create" class="btn btn-main mb-3">+ Добави продукт</a>
}

<!-- FILTER -->
<form asp-controller="Product" asp-action="Index" method="get" class="row mb-4">
    <div class="col-md-4">
        <input type="text" name="SearchStringBrandName" class="form-control" placeholder="Марка..." />
    </div>
    <div class="col-md-4">
        <input type="text" name="SearchStringCategoryName" class="form-control" placeholder="Категория..." />
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-main w-100">Филтрирай</button>
    </div>
</form>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm border-0">

                <!-- IMAGE -->
                <img src="@item.Picture" class="card-img-top" style="height:250px; object-fit:cover;" />

                <div class="card-body d-flex flex-column">

                    <!-- NAME -->
                    <h5 class="card-title">@item.ProductName</h5>

                    <!-- BRAND + CATEGORY -->
                    <p class="text-muted mb-1">@item.BrandName | @item.CategoryName</p>

                    <!-- DESCRIPTION -->
                    <p class="card-text small">
                        @(item.Description?.Length > 80 ? item.Description.Substring(0, 80) + "..." : item.Description)
                    </p>

                    <!-- PRICE -->
                    <p class="fw-bold mt-auto">
                        @item.Price лв.
                        @if (item.Discount > 0)
                        {
                            <span class="text-danger">(-@item.Discount%)</span>
                        }
                    </p>

                    <!-- BUTTONS -->
                    <div class="d-flex justify-content-between align-items-center mt-2">

                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-main">
                            Виж
                        </a>

                        @if ((this.User.Identity.IsAuthenticated) && (this.User.IsInRole("Administrator")))
                        {
                            <div>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </div>
                        }
                    </div>

                    <!-- FAVORITES -->

                    <form asp-controller="Favourite" asp-action="Add" method="post" class="mt-2">
                        <input type="hidden" name="productId" value="@item.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                            ❤️ Любими
                        </button>
                    </form>

                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}