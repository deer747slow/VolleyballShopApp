@model IEnumerable<VolleyballShopApp.Models.Product.ProductIndexVM>

@{
    ViewData["Title"] = "Продукти";
}

<style>
    .products-title {
        color: #0a1f44;
        font-weight: 800;
        font-size: 2.2rem;
        margin-bottom: 25px;
    }

    .filter-box {
        background: #ffffff;
        padding: 20px;
        border-radius: 18px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.08);
        margin-bottom: 30px;
    }

        .filter-box .form-control {
            border-radius: 14px;
            min-height: 48px;
            font-size: 16px;
        }

    .product-card {
        border: none;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 8px 22px rgba(0,0,0,0.08);
        transition: 0.25s ease;
        background: #fff;
    }

        .product-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 14px 28px rgba(0,0,0,0.12);
        }

    .product-image {
        height: 260px;
        object-fit: cover;
        background: #f8f9fc;
    }

    .product-name {
        font-size: 1.3rem;
        font-weight: 700;
        color: #0a1f44;
        margin-bottom: 10px;
    }

    .product-meta {
        color: #6c757d;
        font-size: 15px;
        margin-bottom: 10px;
    }

    .product-description {
        color: #555;
        min-height: 60px;
        margin-bottom: 10px;
    }

    .product-price {
        font-size: 1.2rem;
        font-weight: 800;
        color: #0a1f44;
        margin-top: 10px;
    }

    .discount-text {
        color: #dc3545;
        font-weight: 700;
        margin-left: 6px;
    }

    .btn-fancy-main {
        background: linear-gradient(135deg, #ffd60a, #f0c400);
        color: #111;
        border: none;
        border-radius: 28px;
        font-weight: 700;
        padding: 10px 20px;
        box-shadow: 0 8px 18px rgba(255,214,10,0.28);
        transition: 0.2s ease;
    }

        .btn-fancy-main:hover {
            transform: translateY(-2px);
            color: #111;
            background: linear-gradient(135deg, #ffe14a, #f5c400);
        }

    .btn-fancy-order {
        background: linear-gradient(135deg, #123a7a, #0a1f44);
        color: white;
        border: none;
        border-radius: 28px;
        font-weight: 700;
        padding: 10px 20px;
        box-shadow: 0 8px 18px rgba(10,31,68,0.25);
        transition: 0.2s ease;
        text-decoration: none;
        display: inline-block;
    }

        .btn-fancy-order:hover {
            transform: translateY(-2px);
            color: white;
        }

    .btn-edit-custom {
        border-radius: 28px;
        font-weight: 600;
        padding: 9px 16px;
    }

    .btn-delete-custom {
        border-radius: 28px;
        font-weight: 600;
        padding: 9px 16px;
    }

    .favorites-btn {
        border-radius: 28px;
        font-weight: 700;
        padding: 10px 18px;
        background: #fff5f8;
        border: 1px solid #f3c8d5;
        color: #d63384;
        transition: 0.2s ease;
    }

        .favorites-btn:hover {
            background: #ffe8ef;
            color: #b6256f;
        }

    .button-group-main {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 14px;
        margin-bottom: 10px;
    }

    .button-group-admin {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 10px;
    }
</style>

<h2 class="products-title">🏐 Всички продукти</h2>

@if ((this.User.Identity.IsAuthenticated) && (this.User.IsInRole("Administrator")))
{
    <a asp-action="Create" class="btn btn-fancy-main mb-4">+ Добави продукт</a>
}

<form asp-controller="Product" asp-action="Index" method="get" class="row g-3 filter-box">
    <div class="col-md-4">
        <input type="text" name="SearchStringBrandName" class="form-control" placeholder="Марка..." />
    </div>
    <div class="col-md-4">
        <input type="text" name="SearchStringCategoryName" class="form-control" placeholder="Категория..." />
    </div>
    <div class="col-md-4">
        <button type="submit" class="btn btn-fancy-main w-100">Филтрирай</button>
    </div>
</form>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-6 col-lg-4 mb-4">
            <div class="card product-card h-100">

                <img src="@item.Picture" class="card-img-top product-image" alt="@item.ProductName" />

                <div class="card-body d-flex flex-column">
                    <h5 class="product-name">@item.ProductName</h5>

                    <p class="product-meta">@item.BrandName | @item.CategoryName</p>

                    <p class="product-description">
                        @(string.IsNullOrWhiteSpace(item.Description)
                                            ? "Няма описание за този продукт."
                                            : (item.Description.Length > 80
                                            ? item.Description.Substring(0, 80) + "..."
                                            : item.Description))
                </p>

                    <p class="product-price mt-auto">
                        @item.Price лв.
                    @if (item.Discount > 0)
                        {
                            <span class="discount-text">(-@item.Discount%)</span>
                        }
                    </p>

                    <div class="button-group-main">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-fancy-main">
                            Виж
                        </a>

                        <a asp-controller="Order" asp-action="Create" asp-route-id="@item.Id" class="btn-fancy-order">
                            Поръчай
                        </a>
                    </div>

                    @if ((this.User.Identity.IsAuthenticated) && (this.User.IsInRole("Administrator")))
                    {
                        <div class="button-group-admin">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-dark btn-edit-custom">
                                Edit
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-delete-custom">
                                Delete
                            </a>
                        </div>
                    }

                    <form asp-controller="Favorites" asp-action="Add" method="post" class="mt-3">
                        <input type="hidden" name="productId" value="@item.Id" />
                        <button type="submit" class="btn favorites-btn w-100">
                            ❤️ Любими
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}