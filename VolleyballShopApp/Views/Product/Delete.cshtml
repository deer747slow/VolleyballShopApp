@model VolleyballShopApp.Models.Product.ProductDeleteVM
@{
    ViewData["Title"] = "Изтриване";
}

<style>
    .delete-box {
        background: #ffffff;
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.08);
        margin-top: 20px;
    }

    .delete-title {
        color: #0a1f44;
        font-weight: 700;
    }

    .delete-warning {
        color: #dc3545;
        font-weight: 600;
        margin-bottom: 20px;
    }

    .details-list dt {
        font-weight: 600;
        color: #0a1f44;
    }

    .details-list dd {
        margin-bottom: 12px;
    }

    .product-img {
        border-radius: 10px;
        margin-top: 5px;
    }

    .action-buttons {
        margin-top: 20px;
    }
</style>

<h1 class="delete-title">Delete</h1>

<div class="delete-box">

    <h3 class="delete-warning">Are you sure you want to delete this?</h3>

    <div>
        <hr />

        <dl class="row details-list">
            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.ProductName)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.ProductName)
            </dd>

            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.BrandName)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.BrandName)
            </dd>

            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.CategoryName)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.CategoryName)
            </dd>

            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Picture)
            </dt>
            <dd class="col-sm-10">
                <img src="@Html.DisplayFor(model => model.Picture)" alt="Image" width="100" class="product-img" />
            </dd>

            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Description)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Description)
            </dd>

            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Quantity)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Quantity)
            </dd>

            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Price)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Price)
            </dd>

            <dt class="col-sm-2">
                @Html.DisplayNameFor(model => model.Discount)
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.Discount)
            </dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />

            <div class="action-buttons">
                <input type="submit" value="Delete" class="btn btn-danger" />
                <a asp-action="Index" class="btn btn-main">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}